{
  "name": "@garkuwa/assay-sdk",
  "version": "0.0.0",
  "description": "Assay SDK: read reserve status and reports from the Assay registry on Stellar",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Garkuwa-Studio/assay",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vectors": "tsx scripts/make-vectors.ts"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
